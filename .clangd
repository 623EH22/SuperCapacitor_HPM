# clangd config template for HPM SDK / RISC-V GCC
# Mirrored from the STM32 project (MDK-ARM/.clangd) and adapted for this toolchain.
# compile_commands.json is generated by CMake into build/hpm5100evk_flash_xip/.
# If you move the build directory, update CompilationDatabase below.

CompileFlags:
  CompilationDatabase: build/hpm5100evk_flash_xip
  Compiler: F:/HPM_SDK/toolchains/rv32imac_zicsr_zifencei_multilib_b_ext-win/bin/riscv32-unknown-elf-gcc.exe
  Add:
    - --target=riscv32-unknown-elf
    - -std=c11
  Remove:
    - -march=*
    - -mabi=*
    - -fno-builtin
    - -ffunction-sections
    - -fdata-sections
    - -mno-save-restore
  # Cross-compile flags above are not always understood by clang's front end.
  # Feature macros (-D...) from compile_commands.json are kept, so indexing still works.

Diagnostics:
  Suppress:
    - unused_includes
    - unknown_argument
