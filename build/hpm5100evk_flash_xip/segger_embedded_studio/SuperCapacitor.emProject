<!DOCTYPE CrossStudio_Project_File>
<solution Name="SuperCapacitor" target="20" version="2">
  <project Name="SuperCapacitor - hpm5100evk">
    <configuration
      Name="Common"
      LIBRARY_IO_TYPE="STD"
      arm_linker_heap_size="0x4000"
      arm_linker_stack_size="0x4000"
      arm_rtl_variant="SEGGER"
      arm_linker_no_warn_on_mismatch="Yes"
      build_generic_options_file_name=""
      c_user_include_directories="../../../hpm_sdk/arch;../../../hpm_sdk/arch/riscv/l1c;../../../hpm_sdk/arch/riscv/intc;../../../hpm_sdk/boards/hpm5100evk;../../../hpm_sdk/soc/HPM5100/HPM5151;../../../hpm_sdk/soc/HPM5100/ip;../../../hpm_sdk/soc/HPM5100/HPM5151/toolchains;../../../hpm_sdk/soc/HPM5100/HPM5151/boot;../../../hpm_sdk/drivers/inc;../../../hpm_sdk/utils;../../../hpm_sdk/components/debug_console;../build_tmp/generated/include;../../../src;../../../src/app;../../../src/hal;../../../src/drv;../../../src/lib;../../../src/lib/SEGGER_RTT;"
      link_linker_script_file="../../../hpm_sdk/soc/HPM5100/HPM5151/toolchains/segger/flash_xip.icf"
      link_use_linker_script_file="Yes"
      linker_output_format="hex"
      project_directory=""
      project_type="Executable"
      debug_target_connection="GDB Server"
      gdb_server_type="Custom"
      gdb_server_reset_command="reset halt"
      gdb_server_autostart_server="Yes"
      gdb_server_port="3333"
      gdb_server_command_line="&quot;$(ProjectDir)/../../../tools/openocd/openocd.exe&quot; -s &quot;$(ProjectDir)/../../../tools/openocd/tcl&quot; -f &quot;$(ProjectDir)/../../../hpm_sdk/boards/openocd/probes/cmsis_dap.cfg&quot; -f &quot;$(ProjectDir)/../../../hpm_sdk/boards/openocd/soc/hpm5100.cfg&quot; -f &quot;$(ProjectDir)/../../../hpm_sdk/boards/openocd/boards/hpm5100evk.cfg&quot;"
      target_device_name="HPM5151xPEx"
      linker_output_format="bin"
      post_build_command="&quot;$(OBJDUMP)&quot; -S -d &quot;$(OutDir)/SuperCapacitor$(EXE)&quot; &gt; &quot;$(OutDir)/SuperCapacitor.asm&quot;"
      heap_size="0x4000"
      stack_size="0x4000"
      RISCV_TOOLCHAIN_VARIANT="Standard"
      rv_abi="ilp32"
      rv_architecture="rv32imac"
      c_additional_options="-Wall;-Wundef;-Wno-format;-Wall;-fomit-frame-pointer;-fno-builtin;-ffunction-sections;-fdata-sections;-g"
      rv_arch_ext=""
      rv_arch_zicsr="Yes"
      rv_arch_zifencei="Yes"
      rv_arch_zba="Yes"
      rv_arch_zbb="Yes"
      rv_arch_zbc="Yes"
      rv_arch_zbs="Yes"
      rv_debug_extensions="None"
      rv_toolchain_prefix=""
      gcc_cplusplus_language_standard="c++11"
      libcxx="Yes"
      build_output_file_name="$(OutDir)/SuperCapacitor$(EXE)"
      linker_printf_fp_enabled="Float"
      linker_printf_fmt_level="int"
      linker_printf_wchar_enabled="No"
      linker_printf_width_precision_supported="Yes"
      linker_scanf_fp_enabled="No"
      linker_scanf_fmt_level="int"
      linker_scanf_character_group_matching_enabled="No"
      gcc_enable_all_warnings="Yes"
      gcc_all_warnings_command_line_options="-Wall;-Wextra;-Wno-format"
      arm_compiler_variant="gcc"
      arm_assembler_variant="SEGGER"
      arm_linker_variant="SEGGER"
      />

