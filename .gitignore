# CMake / Ninja 构建产物：整体忽略，只放行可随仓库提交的 SES 工程和生成头
build/*
!build/hpm5100evk_flash_xip/
build/hpm5100evk_flash_xip/*
!build/hpm5100evk_flash_xip/segger_embedded_studio/
!build/hpm5100evk_flash_xip/build_tmp/
build/hpm5100evk_flash_xip/segger_embedded_studio/Output/
build/hpm5100evk_flash_xip/build_tmp/*
!build/hpm5100evk_flash_xip/build_tmp/generated/
build/hpm5100evk_flash_xip/build_tmp/generated/*
!build/hpm5100evk_flash_xip/build_tmp/generated/include/
compile_commands.json

# IDE 会话与临时文件
*.emSession
*.bak
*.tmp
*.uvguix.*

# 生成的可执行固件
*.elf
*.bin
*.map
*.asm

# 个人 IDE 配置，含本机绝对路径
/.vscode/
/.clangd

# SES 生成的绝对路径描述文件，实际工程入口是 .emProject
/build/hpm5100evk_flash_xip/segger_embedded_studio/SuperCapacitor.json
